{
  "name": "@react-template/bff",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "exports": {
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    }
  },
  "scripts": {
    "dev": "node --watch --env-file=.env src/server.ts",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run --coverage",
    "gen:upstreams": "openapi-typescript openapi/catalog.yaml -o src/clients/generated/catalog.ts && openapi-typescript openapi/profile.yaml -o src/clients/generated/profile.ts"
  },
  "dependencies": {
    "@hono/node-server": "catalog:",
    "@hono/zod-validator": "catalog:",
    "@react-template/shared": "workspace:*",
    "hono": "catalog:",
    "hono-rate-limiter": "catalog:",
    "ioredis": "catalog:",
    "openapi-fetch": "catalog:",
    "openid-client": "catalog:",
    "winston": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@react-template/eslint-config": "workspace:*",
    "@react-template/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "eslint": "catalog:",
    "msw": "catalog:",
    "openapi-typescript": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "@vitest/coverage-v8": "catalog:"
  }
}
