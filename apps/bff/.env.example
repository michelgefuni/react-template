NODE_ENV=development
PORT=3001
API_BASE_PATH=/api
LOG_LEVEL=info
TRUST_PROXY=false
CORS_ALLOWED_ORIGINS=

# @feature-auth-start
OIDC_ISSUER_URL=http://localhost:8080/realms/app
OIDC_CLIENT_ID=web-bff
OIDC_CLIENT_SECRET=dev-only-client-secret-change-me-32b
OIDC_REDIRECT_URI=http://localhost:5173/api/auth/callback
OIDC_POST_LOGOUT_REDIRECT_URI=http://localhost:5173/
OIDC_SCOPES=openid profile email
OIDC_ALLOW_INSECURE_HTTP=true
OIDC_DISCOVERY_ATTEMPTS=5
OIDC_DISCOVERY_DELAY_MS=1000

SESSION_SECRET=development-only-session-secret-change
SESSION_ENCRYPTION_KEY=AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA=
SESSION_COOKIE_SECURE=false
SESSION_IDLE_TTL_SECONDS=1800
SESSION_ABSOLUTE_TTL_SECONDS=28800
SESSION_STORE=memory
REDIS_URL=redis://localhost:6379
TOKEN_REFRESH_SKEW_SECONDS=30
# @feature-auth-end

UPSTREAM_CATALOG_URL=http://localhost:4010
UPSTREAM_CATALOG_AUTH_MODE=none
UPSTREAM_PROFILE_URL=http://localhost:4011
UPSTREAM_PROFILE_AUTH_MODE=user-token
UPSTREAM_TIMEOUT_MS=5000
UPSTREAM_RETRY_COUNT=1

RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=100
BODY_LIMIT_BYTES=1048576
